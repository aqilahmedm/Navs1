# Copy to .env for local runs (python-dotenv is NOT required: just `export` these, or set them in the Render dashboard).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=navs
MONGO_REQUIRED=1          # refuse to start without MongoDB (otherwise everyone is signed out on every restart)
SECRET_KEY=change-me-to-a-long-random-string
APAAR_PROXY=1
DEMO_SHOW_OTP=1           # 0 before any real data goes in
PUBLIC_URL=https://your-app.onrender.com   # used inside QR codes
# hCaptcha (https://dashboard.hcaptcha.com). The sitekey is public; the SECRET must never be committed or put in front-end code.
HCAPTCHA_SITEKEY=9e0af896-09e6-4b0e-b16c-0f8e4c6cd512
HCAPTCHA_SECRET=paste-your-hcaptcha-secret-here
# HCAPTCHA_HOSTNAMES=your-app.onrender.com   # optional: only accept tokens solved on this site
# CERT_SIGNING_KEY=<long random string>   # signs certificates; keep it stable and secret
